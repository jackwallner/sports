<?xml version="1.0" encoding="utf-8"?>
<!-- Only on-device preferences and the briefing cache exist; nothing is account
     bound, so the default backup is safe. Card art is cache and is skipped. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
